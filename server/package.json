{
  "name": "careerconnect",
  "version": "1.0.0",
  "description": "CareerConnect is an online platform designed to help job seekers manage their job search activities. The platform allows users to create profiles, upload and manage resumes, explore job opportunities, monitor submitted applications, and track their application progress.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint src/",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration --passWithNoTests --detectOpenHandles",
    "test:all": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hinduino/CareerConnect.git"
  },
  "keywords": [],
