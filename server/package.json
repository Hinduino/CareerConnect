  "bugs": {
    "url": "https://github.com/Hinduino/CareerConnect/issues"
  },
  "homepage": "https://github.com/Hinduino/CareerConnect#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "course": "^0.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
